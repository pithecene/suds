// The Suds window. Its first view shows one workstation's development
// storage: the pressure, the classes, each checkout, and each store. Its
// second view shows a reclaim plan, which a person approves or leaves.
import { AboutSlint, ComboBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";
import { Check, GroupHead, IconButton, Push, Tones } from "controls.slint";

export struct ClassItem { label: string, detail: string, share: float, tint: color }
// One row of the outline: a project, or one of its checkouts beneath it.
export struct RowItem { project: bool, open: bool, name: string, caption: string, total: string, build: string, modified: string, share: float, build-share: float, state: string, state-rank: int, tint: color }
// A project's frame and a checkout's tile on the storage map. The second rectangle is the build state's part.
export struct FrameItem { id: int, x: length, y: length, w: length, h: length, bx: length, by: length, bw: length, bh: length, name: string, tip: string, labelled: bool, detailed: bool }
export struct TileItem { x: length, y: length, w: length, h: length, bx: length, by: length, bw: length, bh: length, id: int, name: string, tip: string, tint: color }
export struct BuildItem { path: string, ecosystem: string, size: string, modified: string }
export struct FactItem { label: string, value: string }
// One removal of a reclaim plan, one reason that the plan keeps directories, and one result of a run.
export struct PlanItem { id: int, name: string, caption: string, reason: string, size: string, included: bool, checkout: bool }
export struct KeptItem { label: string, detail: string }
export struct OutcomeItem { path: string, detail: string, removed: bool }
export struct StepItem { name: string, path: string, detail: string, done: bool }
export struct RunItem { id: int, name: string, caption: string, size: string, state: string, rank: int }
export struct StoreItem { id: string, path: string, size: string, budget: string, share: float, over: bool, absent: bool, group: bool, open: bool }

// A ring that turns while work runs. The toolkit's spinner draws its arc with square ends and
// in steps at this size, so the window draws its own with round ends on a faint track.
component Busy inherits Rectangle {
    property <angle> turn: 360deg * Math.mod(animation-tick() / 1ms, 900) / 900;
    width: 16px;
    height: 16px;
    accessible-role: none;
    Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: Tones.track;
        stroke-width: 1.75px;
        MoveTo { x: 14; y: 8; }
        ArcTo { x: 2; y: 8; radius-x: 6; radius-y: 6; sweep: true; }
        ArcTo { x: 14; y: 8; radius-x: 6; radius-y: 6; sweep: true; }
    }
    Path {
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: Palette.accent-background;
        stroke-width: 1.75px;
        stroke-line-cap: round;
        MoveTo {
            x: 8 + 6 * Math.cos(root.turn);
            y: 8 + 6 * Math.sin(root.turn);
        }
        ArcTo {
            x: 8 + 6 * Math.cos(root.turn + 100deg);
            y: 8 + 6 * Math.sin(root.turn + 100deg);
            radius-x: 6;
            radius-y: 6;
            sweep: true;
        }
    }
}

component Caption inherits Text {
    color: Tones.muted;
    font-size: 11px;
    overflow: elide;
}

component Heading inherits Text {
    color: Tones.muted;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

// A horizontal bar that fills a share of its track.
component Meter inherits Rectangle {
    in property <float> share;
    in property <brush> fill: Palette.accent-background;
    height: 6px;
    border-radius: self.height / 2;
    background: Tones.track;
    accessible-role: none;
    Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.share));
        border-radius: parent.border-radius;
        background: root.fill;
    }
}

// A bar that fills a share of its track, with the build state's part of the fill in its own tint.
component Split inherits Rectangle {
    in property <float> share;
    in property <float> build-share;
    in property <brush> fill;
    property <length> filled: self.width * max(0, min(1, root.share));
    height: 6px;
    border-radius: self.height / 2;
    background: Tones.track;
    clip: true;
    accessible-role: none;
    Rectangle {
        x: 0;
        width: root.filled;
        background: root.fill;
    }
    Rectangle {
        x: root.filled * (1 - root.build-share);
        width: root.filled * root.build-share;
        background: Tones.build;
    }
}

// One entry of the map's legend.
component Key inherits HorizontalLayout {
    in property <brush> tint;
    in property <string> text;
    horizontal-stretch: 0;
    spacing: 5px;
    VerticalLayout {
        alignment: center;
        Rectangle { width: 8px; height: 8px; border-radius: 2px; background: root.tint; }
    }
    Caption { text: root.text; vertical-alignment: center; }
}

component Card inherits Rectangle {
    background: Palette.control-background;
    border-width: 1px;
    border-color: Tones.hairline;
    border-radius: 8px;
}

export component Window inherits Window {
    // The reading in progress, and the reason that the last one showed nothing.
    in property <bool> loading;
    in property <string> notice;
    // What a whole reading still leaves for a person to know, one item for each line.
    in property <[string]> notices;
    in property <bool> measured;
    in property <string> observed;
    // What About states of this build: its version and commit, then its owner and licence.
    in property <string> build;
    in property <[string]> build-notice;

    in property <string> usage;
    in property <string> ceiling;
    in property <string> level;
    in property <int> level-rank;
    in property <float> pressure-share;
    in property <string> pressure-facts;

    in property <[ClassItem]> classes;
    in property <[RowItem]> rows;
    in property <[FrameItem]> frames;
    in property <[TileItem]> tiles;
    in property <string> checkout-count;
    // The identifiers of the selected checkout's tile and of the selected project's frame.
    in property <int> selected-tile: -1;
    in property <int> selected-frame: -1;
    in property <[StoreItem]> stores;

    in property <bool> has-detail;
    in property <string> detail-kind;
    in property <string> detail-name;
    in property <string> detail-path;
    in property <[FactItem]> detail-facts;
    in property <[BuildItem]> detail-builds;

    // The page: 0 shows the storage, 1 shows the reclaim plan, and 2 shows the history.
    in property <int> page;
    in property <bool> planning;
    in property <bool> applying;
    in property <string> plan-error;
    in property <[PlanItem]> plan-rows;
    in property <[KeptItem]> plan-kept;
    in property <string> plan-summary;
    in property <int> plan-count;
    // The words on the button that approves the run.
    in property <string> plan-action;
    // What the plan says of a partial inspection and of hidden processes, and whether those processes keep each directory.
    in property <string> plan-hidden;
    in property <bool> plan-held;
    in property <int> plan-selected: -1;
    // The plan's scroll offset and the height that it shows, for a row that a key selects.
    in-out property <length> plan-y;
    out property <length> plan-visible;
    // Whether a person asked the window to close during a run.
    in property <bool> closing;
    in property <[string]> plan-evidence;
    in property <bool> has-outcome;
    in property <[OutcomeItem]> outcome-rows;
    in property <string> outcome-summary;
    // Whether the window asks once more before a run.
    in-out property <bool> confirming;

    // The history: the journal's runs, and the steps of the selected run.
    in property <bool> history-loading;
    in property <string> history-error;
    in property <[RunItem]> history-rows;
    in property <string> history-summary;
    in property <int> history-selected: -1;
    in property <string> history-run;
    in property <[StepItem]> history-steps;
    // The history's scroll offset and the height that it shows, for a row that a key selects.
    in-out property <length> history-y;
    out property <length> history-visible;

    in-out property <string> query;
    in-out property <int> sort: 0;
    in-out property <int> selected: -1;
    // The outline's scroll offset and the height that it shows, for a row that the map selects.
    in-out property <length> list-y;
    out property <length> list-visible;

    callback refresh();
    callback arrange(query: string, sort: int);
    // A click on a row: it selects the row, opens or closes a project, and lets a selected checkout go.
    callback activate(row: int);
    // A key's move to a row, which selects it and changes nothing else.
    callback move(row: int);
    callback open(row: int, open: bool);
    callback clear();
    callback pick(checkout: int);
    callback pick-project(frame: int);
    callback layout(width: length, height: length);
    callback quit();
    // The plan's view: build a plan, mark a removal, read its evidence, approve the run, and leave.
    callback plan(tolerate: bool);
    callback plan-toggle(id: int);
    callback plan-pick(id: int);
    // A key's move through the removals, which selects a row and changes no mark.
    callback plan-step(step: int);
    callback plan-apply();
    callback plan-close();
    // The history: read the journal, select a run, move through the runs by key, and leave.
    // The stores' pane: what a group's stores share, 0 for the ecosystem, 1 for the tool, and 2 for the class.
    in-out property <int> store-grouping;
    callback store-group(grouping: int);
    callback store-toggle(label: string);
    callback history();
    callback history-pick(id: int);
    callback history-step(step: int);
    callback history-close();

    // What the pointer rests on in the map.
    property <string> hover;

    // Each request for the filter's focus. The filter stands inside a condition, so it watches this count.
    property <int> search-requests;
    property <color> level-tint: level-rank == 2 ? Tones.hard : level-rank == 1 ? Tones.soft : Tones.normal;

    title: "Suds";
    icon: @image-url("../assets/suds.svg");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 880px;
    min-height: 560px;
    background: Palette.background;
    default-font-size: 13px;

    about := PopupWindow {
        x: (root.width - 360px) / 2;
        y: (root.height - 420px) / 2;
        width: 360px;
        height: 420px;
        Card {
            background: Palette.background;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Suds"; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                Caption { text: "Bounded development storage for one workstation."; horizontal-alignment: center; }
                Text { text: "Version " + root.build; horizontal-alignment: center; wrap: word-wrap; }
                VerticalLayout {
                    spacing: 2px;
                    for line in root.build-notice: Caption { text: line; horizontal-alignment: center; }
                }
                AboutSlint { }
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "f") {
                root.search-requests += 1;
                return accept;
            }
            if (event.modifiers.control && event.text == "q") {
                root.quit();
                return accept;
            }
            if (event.modifiers.control && event.text == "r") {
                root.refresh();
                return accept;
            }
            if (root.page == 1) {
                if (event.text == Key.Escape && !root.applying) {
                    root.plan-close();
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.plan-step(1);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.plan-step(-1);
                    return accept;
                }
                if (event.text == " " && root.plan-selected >= 0) {
                    root.plan-toggle(root.plan-selected);
                    return accept;
                }
                return reject;
            }
            if (root.page == 2) {
                if (event.text == Key.Escape) {
                    root.history-close();
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.history-step(1);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.history-step(-1);
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.DownArrow && root.selected < root.rows.length - 1) {
                root.move(root.selected + 1);
                return accept;
            }
            if (event.text == Key.UpArrow && root.selected > 0) {
                root.move(root.selected - 1);
                return accept;
            }
            if (event.text == Key.RightArrow && root.selected >= 0) {
                root.open(root.selected, true);
                return accept;
            }
            if (event.text == Key.LeftArrow && root.selected >= 0) {
                root.open(root.selected, false);
                return accept;
            }
            if (event.text == Key.Escape) {
                root.clear();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 12px;
            spacing: 12px;

            // Before the first reading, the window shows only that it measures.
            if !root.measured && root.notice == "": HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Busy { }
                Caption { text: "Measuring the development storage…"; vertical-alignment: center; }
            }

            if root.notice != "": Card {
                vertical-stretch: 0;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    Text { text: root.notice; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                    if !root.measured: VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("../assets/refresh.svg");
                            label: "Measure again";
                            enabled: !root.loading;
                            clicked => { root.refresh(); }
                        }
                    }
                }
            }

            if root.measured: HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                Card {
                    horizontal-stretch: 1;
                    accessible-role: groupbox;
                    accessible-label: "Development storage, " + root.usage + " of " + root.ceiling + ", " + root.level;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            height: 24px;
                            Heading { text: "DEVELOPMENT STORAGE"; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: pill.preferred-width + 16px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: root.level-tint.with-alpha(0.16);
                                    pill := Text { text: root.level; color: root.level-tint; font-size: 11px; font-weight: 600; }
                                }
                            }
                            // The notices stand behind a chip, so their count never moves the storage.
                            if root.notices.length > 0: VerticalLayout {
                                alignment: center;
                                chip := Rectangle {
                                    width: chip-text.preferred-width + 16px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: Tones.soft.with-alpha(chip-area.has-hover ? 0.28 : 0.16);
                                    border-width: chip-scope.has-focus ? 2px : 0px;
                                    border-color: Palette.accent-background;
                                    accessible-role: button;
                                    accessible-label: chip-text.text + ". Return shows them.";
                                    accessible-action-default => { notes.show(); }
                                    forward-focus: chip-scope;
                                    chip-scope := FocusScope {
                                        key-pressed(event) => {
                                            if (event.text == Key.Return || event.text == " ") {
                                                notes.show();
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                    chip-text := Text {
                                        text: root.notices.length == 1 ? "1 notice" : root.notices.length + " notices";
                                        color: Tones.soft;
                                        font-size: 11px;
                                        font-weight: 600;
                                        accessible-role: none;
                                    }
                                    chip-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { notes.show(); }
                                    }
                                    notes := PopupWindow {
                                        x: 0px;
                                        y: parent.height + 6px;
                                        width: 460px;
                                        Card {
                                            background: Palette.background;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 10px;
                                                for line[position] in root.notices: VerticalLayout {
                                                    spacing: 10px;
                                                    if position > 0: Rectangle { height: 1px; background: Tones.hairline; }
                                                    Text { text: line; wrap: word-wrap; font-size: 12px; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Caption {
                                horizontal-stretch: 1;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                text: root.loading ? "Measured " + root.observed + " · measuring again…" : "Measured " + root.observed;
                            }
                            if root.loading: VerticalLayout {
                                alignment: center;
                                Busy { }
                            }
                            if root.page == 0: VerticalLayout {
                                alignment: center;
                                Push {
                                    text: "Free space…";
                                    height: 24px;
                                    enabled: !root.loading;
                                    accessible-label: "Free space. Suds plans what it can remove and removes nothing before an approval.";
                                    clicked => {
                                        root.plan(false);
                                        keys.focus();
                                    }
                                }
                            }
                            if root.page == 0: VerticalLayout {
                                alignment: center;
                                Push {
                                    text: "History";
                                    height: 24px;
                                    accessible-label: "History. Each run that the journal records.";
                                    clicked => {
                                        root.history();
                                        keys.focus();
                                    }
                                }
                            }
                            IconButton {
                                icon: @image-url("../assets/refresh.svg");
                                label: "Measure again. Control and R does the same.";
                                enabled: !root.loading;
                                clicked => { root.refresh(); }
                            }
                            IconButton {
                                icon: @image-url("../assets/about.svg");
                                label: "About Suds";
                                clicked => { about.show(); }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            height: 30px;
                            Text { text: root.usage; font-size: 24px; font-weight: 600; vertical-alignment: bottom; }
                            VerticalLayout {
                                alignment: end;
                                padding-bottom: 4px;
                                Text { text: "of " + root.ceiling; color: Tones.muted; }
                            }
                        }
                        Meter { height: 8px; share: root.pressure-share; fill: root.level-tint; }
                        Caption { text: root.pressure-facts; }
                    }
                }
                Card {
                    horizontal-stretch: 1;
                    accessible-role: groupbox;
                    accessible-label: "Storage by class";
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Heading { text: "BY CLASS"; height: 24px; vertical-alignment: center; }
                        HorizontalLayout {
                            height: 12px;
                            spacing: 2px;
                            for class in root.classes: Rectangle {
                                horizontal-stretch: class.share;
                                min-width: 0px;
                                visible: class.share > 0;
                                background: class.tint;
                                border-radius: 3px;
                            }
                        }
                        // The classes stand in two columns, so the card stays as tall as the pressure's.
                        HorizontalLayout {
                            spacing: 24px;
                            for column in 2: VerticalLayout {
                                spacing: 6px;
                                alignment: start;
                                for class[position] in root.classes: HorizontalLayout {
                                    visible: Math.mod(position, 2) == column;
                                    height: self.visible ? 18px : 0px;
                                    spacing: 8px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: class.tint; }
                                    }
                                    Text { text: class.label; font-size: 12px; vertical-alignment: center; }
                                    Caption { text: class.detail; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }

            if root.measured && root.page == 1: HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                Card {
                    horizontal-stretch: 1;
                    clip: true;
                    accessible-role: groupbox;
                    accessible-label: "Reclaim plan";
                    VerticalLayout {
                        HorizontalLayout {
                            padding: 10px;
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 10px;
                            height: 46px;
                            Heading { text: root.has-outcome ? "RECLAIM RUN" : "RECLAIM PLAN"; vertical-alignment: center; }
                            Caption {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                text: root.planning ? "" : root.has-outcome ? "" : root.plan-summary;
                            }
                            Push {
                                text: root.has-outcome ? "Done" : "Back";
                                enabled: !root.applying;
                                accessible-label: "Return to the storage. Escape does the same.";
                                clicked => { root.plan-close(); }
                            }
                        }
                        Rectangle { height: 1px; background: Tones.hairline; }

                        if root.planning || root.applying: VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 10px;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Busy { }
                                Text {
                                    vertical-alignment: center;
                                    text: root.applying ? "Removing what the plan names…" : "Planning what Suds can remove…";
                                }
                            }
                            Caption {
                                horizontal-alignment: center;
                                text: root.closing ? "The window closes once the run ends." : root.applying ? "Suds verifies each directory again before it removes it." : "Suds asks Git about each checkout and reads the working directory of each process. Nothing changes.";
                            }
                        }

                        if !root.planning && !root.applying && root.plan-error != "": VerticalLayout {
                            vertical-stretch: 1;
                            padding: 16px;
                            alignment: start;
                            Text { text: root.plan-error; wrap: word-wrap; }
                        }

                        if !root.planning && !root.applying && root.plan-error == "" && root.has-outcome: VerticalLayout {
                            vertical-stretch: 1;
                            HorizontalLayout {
                                padding: 16px;
                                Text { text: root.outcome-summary; wrap: word-wrap; }
                            }
                            Rectangle { height: 1px; background: Tones.hairline; }
                            ListView {
                                vertical-stretch: 1;
                                accessible-role: list;
                                accessible-label: "What the run did with each directory";
                                for result in root.outcome-rows: Rectangle {
                                    height: 38px;
                                    accessible-role: list-item;
                                    accessible-label: result.path + ", " + result.detail;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 10px;
                                        Text {
                                            width: 14px;
                                            text: result.removed ? "✓" : "–";
                                            color: result.removed ? Tones.normal : Tones.soft;
                                            vertical-alignment: center;
                                            accessible-role: none;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: result.path; overflow: elide; }
                                            Caption { text: result.detail; }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Tones.hairline; }
                                }
                            }
                        }

                        if !root.planning && !root.applying && root.plan-error == "" && !root.has-outcome: VerticalLayout {
                            vertical-stretch: 1;
                            if root.plan-hidden != "": HorizontalLayout {
                                padding: 12px;
                                padding-left: 16px;
                                spacing: 12px;
                                Text { text: root.plan-hidden; wrap: word-wrap; horizontal-stretch: 1; font-size: 12px; vertical-alignment: center; }
                                if root.plan-held: VerticalLayout {
                                    alignment: center;
                                    Push {
                                        text: "Plan without them";
                                        accessible-label: "Plan again, and proceed although the system hides those processes";
                                        clicked => {
                                            root.plan(true);
                                            keys.focus();
                                        }
                                    }
                                }
                            }
                            if root.plan-hidden != "": Rectangle { height: 1px; background: Tones.hairline; }
                            if root.plan-rows.length == 0: VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 6px;
                                Text { text: "The plan removes nothing."; horizontal-alignment: center; font-weight: 600; }
                                Caption { text: "Each directory that Suds considered has a reason to stay."; horizontal-alignment: center; }
                            }
                            if root.plan-rows.length > 0: ListView {
                                vertical-stretch: 1;
                                accessible-role: list;
                                accessible-label: "Directories that the plan removes, largest first. Up and Down select a removal, and Space marks it.";
                                content-y <=> root.plan-y;
                                init => { root.plan-visible = self.visible-height; }
                                changed visible-height => { root.plan-visible = self.visible-height; }
                                for row in root.plan-rows: Rectangle {
                                    height: 44px;
                                    accessible-role: list-item;
                                    accessible-action-default => { root.plan-pick(row.id); }
                                    accessible-label: row.name + ", " + row.caption + ", " + row.size + ", " + row.reason;
                                    accessible-item-selectable: true;
                                    accessible-item-selected: row.id == root.plan-selected;
                                    background: row.id == root.plan-selected ? Palette.selection-background : touch.has-hover ? Tones.hover : transparent;
                                    touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.plan-pick(row.id);
                                            keys.focus();
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            alignment: center;
                                            Check {
                                                checked: row.included;
                                                label: "Remove " + row.name;
                                                toggled => { root.plan-toggle(row.id); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle { width: 8px; height: 8px; border-radius: 2px; background: row.checkout ? Tones.linked : Tones.build; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: row.name;
                                                overflow: elide;
                                                opacity: row.included ? 1 : 0.5;
                                                color: row.id == root.plan-selected ? Palette.selection-foreground : Palette.foreground;
                                            }
                                            Caption { text: row.caption; }
                                        }
                                        Text {
                                            width: 84px;
                                            text: row.size;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            opacity: row.included ? 1 : 0.5;
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Tones.hairline; }
                                }
                            }
                            Rectangle { height: 1px; background: Tones.hairline; }
                            HorizontalLayout {
                                padding: 12px;
                                padding-left: 16px;
                                spacing: 12px;
                                height: 56px;
                                Caption {
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    text: root.confirming ? "A removal is permanent. A build makes build state again, and a remote holds a removed worktree's commits." : "Suds removes nothing before an approval, and verifies each directory again before it removes it.";
                                }
                                if root.confirming: VerticalLayout {
                                    alignment: center;
                                    Push {
                                        text: "Cancel";
                                        clicked => { root.confirming = false; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Push {
                                        primary: true;
                                        enabled: root.plan-count > 0;
                                        text: root.confirming ? "Remove permanently" : root.plan-action;
                                        accessible-label: root.confirming ? "Remove permanently, " + root.plan-summary : root.plan-action + ". The window asks once more.";
                                        clicked => {
                                            if (root.confirming) {
                                                root.confirming = false;
                                                root.plan-apply();
                                            } else {
                                                root.confirming = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    width: 340px;
                    spacing: 12px;

                    Card {
                        vertical-stretch: 0;
                        clip: true;
                        accessible-role: groupbox;
                        accessible-label: "Evidence for the selected removal";
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Heading { text: "EVIDENCE"; }
                            if root.plan-evidence.length == 0: Caption { text: "Select a removal to read each fact that the plan found for it."; wrap: word-wrap; }
                            if root.plan-evidence.length > 0: ScrollView {
                                height: min(facts.preferred-height, 320px);
                                content-width: self.visible-width;
                                content-height: facts.preferred-height;
                                // Another removal's evidence starts at its path.
                                property <int> shown: root.plan-selected;
                                changed shown => { self.content-y = 0; }
                                facts := VerticalLayout {
                                    width: parent.visible-width;
                                    alignment: start;
                                    spacing: 8px;
                                    for fact[position] in root.plan-evidence: Text {
                                        text: fact;
                                        font-size: 12px;
                                        wrap: position == 0 ? char-wrap : word-wrap;
                                        color: position == 0 ? Tones.muted : Palette.foreground;
                                    }
                                }
                            }
                        }
                    }

                    Card {
                        vertical-stretch: 1;
                        min-height: 140px;
                        clip: true;
                        accessible-role: groupbox;
                        accessible-label: "What the plan keeps, by reason";
                        VerticalLayout {
                            padding-top: 16px;
                            spacing: 8px;
                            HorizontalLayout {
                                padding-left: 16px;
                                Heading { text: "KEPT"; }
                            }
                            ScrollView {
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-bottom: 16px;
                                    spacing: 10px;
                                    alignment: start;
                                    if root.plan-kept.length == 0 && !root.planning: Caption { text: "The plan keeps nothing that it considered."; wrap: word-wrap; }
                                    for group in root.plan-kept: VerticalLayout {
                                        spacing: 2px;
                                        accessible-role: list-item;
                                        accessible-label: group.label + ", " + group.detail;
                                        Text { text: group.label; font-size: 12px; wrap: word-wrap; }
                                        Caption { text: group.detail; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.measured && root.page == 2: HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                Card {
                    horizontal-stretch: 1;
                    clip: true;
                    accessible-role: groupbox;
                    accessible-label: "History";
                    VerticalLayout {
                        HorizontalLayout {
                            padding: 10px;
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 10px;
                            height: 46px;
                            Heading { text: "HISTORY"; vertical-alignment: center; }
                            Caption {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                text: root.history-summary;
                            }
                            Push {
                                text: "Back";
                                accessible-label: "Return to the storage. Escape does the same.";
                                clicked => { root.history-close(); }
                            }
                        }
                        Rectangle { height: 1px; background: Tones.hairline; }

                        if root.history-loading: HorizontalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 8px;
                            Busy { }
                            Text { vertical-alignment: center; text: "Reading the journal…"; }
                        }
                        if !root.history-loading && root.history-error != "": VerticalLayout {
                            vertical-stretch: 1;
                            padding: 16px;
                            alignment: start;
                            Text { text: root.history-error; wrap: word-wrap; }
                        }
                        if !root.history-loading && root.history-error == "" && root.history-rows.length == 0: VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 6px;
                            Text { text: "The journal records no run."; horizontal-alignment: center; font-weight: 600; }
                            Caption { text: "A reclaim, a store's trim, and a move each leave a run here."; horizontal-alignment: center; }
                        }
                        if !root.history-loading && root.history-error == "" && root.history-rows.length > 0: ListView {
                            vertical-stretch: 1;
                            accessible-role: list;
                            accessible-label: "Runs that the journal records, most recent first. Up and Down select a run.";
                            content-y <=> root.history-y;
                            init => { root.history-visible = self.visible-height; }
                            changed visible-height => { root.history-visible = self.visible-height; }
                            for row in root.history-rows: Rectangle {
                                property <bool> picked: row.id == root.history-selected;
                                property <brush> tint: self.picked ? Palette.selection-foreground : row.rank == 3 ? Tones.muted : row.rank == 2 ? Tones.hard : row.rank == 1 ? Tones.soft : Tones.normal;
                                height: 44px;
                                accessible-role: list-item;
                                accessible-action-default => { root.history-pick(row.id); }
                                accessible-label: row.name + ", " + row.state + ", " + row.caption + (row.size != "" ? ", freed " + row.size : "");
                                accessible-item-selectable: true;
                                accessible-item-selected: row.id == root.history-selected;
                                background: row.id == root.history-selected ? Palette.selection-background : pointer.has-hover ? Tones.hover : transparent;
                                pointer := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.history-pick(row.id);
                                        keys.focus();
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: row.name;
                                            overflow: elide;
                                            color: row.id == root.history-selected ? Palette.selection-foreground : Palette.foreground;
                                        }
                                        Caption { text: row.caption; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: outcome.preferred-width + 16px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: tint.transparentize(0.84);
                                            outcome := Text { text: row.state; color: tint; font-size: 11px; font-weight: 600; }
                                        }
                                    }
                                    Text {
                                        width: 84px;
                                        text: row.size;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Tones.hairline; }
                            }
                        }
                    }
                }

                Card {
                    width: 400px;
                    clip: true;
                    accessible-role: groupbox;
                    accessible-label: "Steps of the selected run";
                    VerticalLayout {
                        padding-top: 16px;
                        spacing: 8px;
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 4px;
                            Heading { text: "RUN"; }
                            if root.history-selected < 0: Caption { text: "Select a run to read what it did with each path."; wrap: word-wrap; }
                            if root.history-selected >= 0: Caption { text: root.history-run; wrap: char-wrap; }
                            if root.history-selected >= 0 && root.history-steps.length == 0: Caption { text: "The journal records no step of this run."; wrap: word-wrap; }
                        }
                        ListView {
                            vertical-stretch: 1;
                            accessible-role: list;
                            accessible-label: "What the run did with each path";
                            for result in root.history-steps: Rectangle {
                                // A step that did not succeed shows its reason on two lines.
                                height: result.done ? 38px : 54px;
                                accessible-role: list-item;
                                accessible-label: result.path + ", " + result.detail;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 10px;
                                    Text {
                                        width: 14px;
                                        text: result.done ? "✓" : "–";
                                        color: result.done ? Tones.normal : Tones.soft;
                                        vertical-alignment: center;
                                        accessible-role: none;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: result.name; overflow: elide; }
                                        Caption { text: result.detail; wrap: word-wrap; overflow: elide; max-height: 28px; }
                                    }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Tones.hairline; }
                            }
                        }
                    }
                }
            }

            if root.measured && root.page == 0: HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                Card {
                    horizontal-stretch: 1;
                    clip: true;
                    VerticalLayout {
                        HorizontalLayout {
                            padding: 10px;
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 10px;
                            Heading { text: "PROJECTS"; vertical-alignment: center; }
                            Caption { text: root.checkout-count; vertical-alignment: center; horizontal-stretch: 1; }
                            search := LineEdit {
                                width: 240px;
                                placeholder-text: "Filter by path";
                                text <=> root.query;
                                accessible-label: "Filter the checkouts by path";
                                property <int> requests: root.search-requests;
                                changed requests => { self.focus(); }
                                edited(text) => { root.arrange(text, root.sort); }
                            }
                            ComboBox {
                                width: 150px;
                                model: ["By size", "By name", "By last change", "By build state"];
                                current-index <=> root.sort;
                                accessible-label: "Order of the projects and their checkouts";
                                selected => { root.arrange(root.query, self.current-index); }
                            }
                        }
                        Rectangle { height: 1px; background: Tones.hairline; }
                        // The storage map: a rectangle's area is its size on disk.
                        Rectangle {
                            vertical-stretch: 2;
                            min-height: 120px;
                            HorizontalLayout {
                                padding: 10px;
                                padding-bottom: 0px;
                                Rectangle {
                                    clip: true;
                                    accessible-role: groupbox;
                                    accessible-label: "Storage map. Each rectangle's area is the size of a checkout, inside its project.";
                                    init => { root.layout(self.width, self.height); }
                                    changed width => { root.layout(self.width, self.height); }
                                    changed height => { root.layout(self.width, self.height); }
                                    TouchArea {
                                        changed has-hover => {
                                            if (!self.has-hover) {
                                                root.hover = "";
                                            }
                                        }
                                        clicked => {
                                            root.clear();
                                            keys.focus();
                                        }
                                    }
                                    for frame in root.frames: Rectangle {
                                        x: frame.x;
                                        y: frame.y;
                                        width: max(0px, frame.w - 1px);
                                        height: max(0px, frame.h - 1px);
                                        background: frame.detailed ? Tones.track : Tones.main;
                                        border-radius: 2px;
                                        clip: true;
                                        if !frame.detailed: Rectangle {
                                            x: frame.bx - frame.x;
                                            y: frame.by - frame.y;
                                            width: frame.bw;
                                            height: frame.bh;
                                            background: Tones.build;
                                        }
                                        if frame.labelled: Text {
                                            x: 4px;
                                            y: 0px;
                                            width: parent.width - 8px;
                                            height: 15px;
                                            text: frame.name;
                                            font-size: 10px;
                                            font-weight: 600;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            color: Tones.muted;
                                            accessible-role: none;
                                        }
                                        over-frame := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.hover = frame.tip;
                                                }
                                            }
                                            clicked => {
                                                root.pick-project(frame.id);
                                                keys.focus();
                                            }
                                        }
                                        if over-frame.has-hover && frame.id != root.selected-frame: Rectangle {
                                            border-width: 2px;
                                            border-color: Tones.outline;
                                            border-radius: 2px;
                                        }
                                        if frame.id == root.selected-frame: Rectangle {
                                            border-width: 2px;
                                            border-color: Palette.foreground;
                                            border-radius: 2px;
                                        }
                                    }
                                    for tile in root.tiles: Rectangle {
                                        x: tile.x;
                                        y: tile.y;
                                        width: max(0px, tile.w - 1px);
                                        height: max(0px, tile.h - 1px);
                                        background: tile.tint;
                                        clip: true;
                                        Rectangle {
                                            x: tile.bx - tile.x;
                                            y: tile.by - tile.y;
                                            width: tile.bw;
                                            height: tile.bh;
                                            background: Tones.build;
                                        }
                                        if tile.w > 64px && tile.h > 20px: Text {
                                            x: 5px;
                                            y: 3px;
                                            width: parent.width - 10px;
                                            text: tile.name;
                                            font-size: 10px;
                                            overflow: elide;
                                            color: white;
                                            accessible-role: none;
                                        }
                                        over-tile := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.hover = tile.tip;
                                                }
                                            }
                                            clicked => {
                                                root.pick(tile.id);
                                                keys.focus();
                                            }
                                        }
                                        if over-tile.has-hover && tile.id != root.selected-tile: Rectangle {
                                            border-width: 2px;
                                            border-color: Tones.outline;
                                        }
                                        if tile.id == root.selected-tile: Rectangle {
                                            border-width: 2px;
                                            border-color: Palette.foreground;
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            height: 26px;
                            spacing: 14px;
                            Caption {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                text: root.hover != "" ? root.hover : "Area is size on disk. Select a rectangle or a row.";
                            }
                            Key { tint: Tones.main; text: "Repository"; }
                            Key { tint: Tones.linked; text: "Worktree"; }
                            Key { tint: Tones.build; text: "Build state"; }
                        }
                        Rectangle { height: 1px; background: Tones.hairline; }
                        outline := ListView {
                            vertical-stretch: 3;
                            min-height: 114px;
                            accessible-role: list;
                            accessible-label: "Projects and their checkouts";
                            content-y <=> root.list-y;
                            init => { root.list-visible = self.visible-height; }
                            changed visible-height => { root.list-visible = self.visible-height; }
                            for row[position] in root.rows: Rectangle {
                                height: 38px;
                                accessible-role: list-item;
                                accessible-label: (row.project ? "Project " : "Checkout ") + row.name + ", " + row.caption + ", " + row.total + ", " + row.build + (row.state != "" ? ", " + row.state : "");
                                accessible-item-selectable: true;
                                accessible-item-selected: position == root.selected;
                                accessible-item-index: position;
                                accessible-expandable: row.project;
                                accessible-expanded: row.open;
                                background: position == root.selected ? Palette.selection-background : area.has-hover ? Tones.hover : transparent;
                                area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.activate(position);
                                        keys.focus();
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: row.project ? 12px : 34px;
                                    padding-right: 16px;
                                    spacing: 10px;
                                    Text {
                                        width: 12px;
                                        text: row.project ? (row.open ? "▾" : "▸") : "";
                                        visible: row.project;
                                        vertical-alignment: center;
                                        color: Tones.muted;
                                        accessible-role: none;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: row.name;
                                            overflow: elide;
                                            font-weight: row.project ? 600 : 400;
                                            color: position == root.selected ? Palette.selection-foreground : Palette.foreground;
                                        }
                                        Caption { text: row.caption; }
                                    }
                                    Caption {
                                        width: 116px;
                                        text: row.state;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        color: row.state-rank == 1 ? Tones.main : row.state-rank == 2 ? Tones.normal : Tones.muted;
                                    }
                                    VerticalLayout {
                                        width: 150px;
                                        alignment: center;
                                        Split { share: row.share; build-share: row.build-share; fill: row.tint; }
                                    }
                                    Text { width: 78px; text: row.total; horizontal-alignment: right; vertical-alignment: center; font-weight: row.project ? 600 : 400; }
                                    Caption { width: 104px; text: row.build; horizontal-alignment: right; vertical-alignment: center; }
                                    Caption { width: 74px; text: row.modified; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Tones.hairline; }
                            }
                        }
                    }
                }

                VerticalLayout {
                    width: 340px;
                    spacing: 12px;

                    Card {
                        // The pane grows only for a list of build directories, and then shares the column.
                        vertical-stretch: root.detail-builds.length > 0 ? 1 : 0;
                        clip: true;
                        accessible-role: groupbox;
                        accessible-label: root.has-detail ? root.detail-kind + " " + root.detail-name : "Nothing selected";
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Heading { text: root.has-detail ? root.detail-kind : "SELECTION"; }
                            if !root.has-detail: Caption { text: "Select a project or a checkout to read its size, its build state, and whether a tool is using it. Escape lets the selection go."; wrap: word-wrap; }
                            if root.has-detail: Text { text: root.detail-name; font-size: 15px; font-weight: 600; overflow: elide; }
                            if root.has-detail: Caption { text: root.detail-path; wrap: char-wrap; overflow: clip; }
                            for fact in root.detail-facts: HorizontalLayout {
                                Caption { text: fact.label; width: 84px; }
                                Text { text: fact.value; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                            // A checkout may hold a hundred build directories, so their list scrolls
                            // inside the pane and never sets the window's height.
                            if root.detail-builds.length > 0: Heading { text: "BUILD DIRECTORIES"; }
                            if root.detail-builds.length > 0: ScrollView {
                                vertical-stretch: 1;
                                min-height: 60px;
                                accessible-role: list;
                                accessible-label: "Build directories, largest first";
                                VerticalLayout {
                                    spacing: 8px;
                                    padding-right: 12px;
                                    alignment: start;
                                    for build in root.detail-builds: VerticalLayout {
                                        spacing: 2px;
                                        accessible-role: list-item;
                                        accessible-label: build.ecosystem + ", " + build.size + ", " + build.path;
                                        HorizontalLayout {
                                            Text { text: build.ecosystem; font-size: 12px; horizontal-stretch: 1; }
                                            Text { text: build.size; font-size: 12px; }
                                        }
                                        Caption { text: build.path; }
                                    }
                                }
                            }
                        }
                    }

                    Card {
                        vertical-stretch: 1;
                        min-height: 140px;
                        clip: true;
                        accessible-role: groupbox;
                        accessible-label: "Shared stores";
                        VerticalLayout {
                            padding-top: 16px;
                            spacing: 8px;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 4px;
                                height: 20px;
                                Heading { text: "SHARED STORES"; horizontal-stretch: 1; vertical-alignment: center; }
                                for name[position] in ["Ecosystem", "Tool", "Class"]: Rectangle {
                                    width: segment.preferred-width + 14px;
                                    border-radius: 5px;
                                    background: root.store-grouping == position ? Tones.track : over-segment.has-hover ? Tones.hover : transparent;
                                    border-width: segment-scope.has-focus ? 2px : 0px;
                                    border-color: Palette.accent-background;
                                    accessible-role: button;
                                    accessible-label: "Group the stores by " + name;
                                    accessible-action-default => { self.choose(); }
                                    forward-focus: segment-scope;
                                    function choose() {
                                        root.store-grouping = position;
                                        root.store-group(position);
                                    }
                                    segment-scope := FocusScope {
                                        key-pressed(event) => {
                                            if (event.text == Key.Return || event.text == " ") {
                                                parent.choose();
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                    segment := Text {
                                        text: name;
                                        font-size: 11px;
                                        font-weight: root.store-grouping == position ? 600 : 400;
                                        color: root.store-grouping == position ? Palette.foreground : Tones.muted;
                                        accessible-role: none;
                                    }
                                    over-segment := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { parent.choose(); }
                                    }
                                }
                            }
                            ScrollView {
                                VerticalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-bottom: 16px;
                                    spacing: 12px;
                                    alignment: start;
                                    for store in root.stores: VerticalLayout {
                                        spacing: 4px;
                                        // A store stands inset beneath its group.
                                        padding-left: store.group ? 0px : 14px;
                                        accessible-role: list-item;
                                        accessible-label: store.id + ", " + store.size + ", " + store.budget;
                                        accessible-expandable: store.group;
                                        accessible-expanded: store.open;
                                        accessible-action-default => {
                                            if (store.group) {
                                                root.store-toggle(store.id);
                                            }
                                        }
                                        if store.group: GroupHead {
                                            name: store.id;
                                            caption: store.budget;
                                            size: store.size;
                                            open: store.open;
                                            size-color: store.over ? Tones.hard : store.absent ? Tones.muted : Palette.foreground;
                                            toggled => { root.store-toggle(store.id); }
                                        }
                                        if !store.group: HorizontalLayout {
                                            height: 16px;
                                            spacing: 6px;
                                            Text {
                                                text: store.id;
                                                font-size: 12px;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: store.size;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                color: store.over ? Tones.hard : store.absent ? Tones.muted : Palette.foreground;
                                            }
                                        }
                                        Meter { share: store.share; fill: store.over ? Tones.hard : Tones.normal; }
                                        if !store.group: Caption { text: store.budget; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if !root.measured: Rectangle { vertical-stretch: 1; }
        }
    }
}
