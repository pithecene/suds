// The window's own controls: the tones, and each button that a click or a key presses.
// The tests import this file, so each control takes its keys without the window around it.

import { Palette } from "std-widgets.slint";

export global Tones {
    out property <color> normal: #2f9e6b;
    out property <color> soft: #d98a00;
    out property <color> hard: #d6453d;
    out property <color> main: #4c7fe0;
    out property <color> linked: #8a72f0;
    out property <color> build: #e0951c;
    out property <brush> muted: Palette.foreground.transparentize(0.42);
    out property <brush> hairline: Palette.foreground.transparentize(0.86);
    out property <brush> track: Palette.foreground.transparentize(0.88);
    out property <brush> hover: Palette.foreground.transparentize(0.94);
    out property <brush> pressed: Palette.foreground.transparentize(0.88);
    // The outline of the map's rectangle beneath the pointer, fainter than a selection's.
    out property <brush> outline: Palette.foreground.transparentize(0.45);
}

// A button that shows an icon alone and states its act to a screen reader.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: area.has-hover && root.enabled ? Tones.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    border-width: scope.has-focus ? 2px : 0px;
    border-color: Palette.accent-background;
    forward-focus: scope;
    // The Tab key reaches the button, and Return or Space presses it.
    scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                // A held key repeats, and a repeat presses nothing: a second press needs a second stroke.
                if (!event.repeat) {
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    Image {
        source: root.icon;
        width: 14px;
        height: 14px;
        colorize: Palette.foreground;
        opacity: root.enabled ? 0.8 : 0.35;
    }
}

// A button with a caption. The pointer becomes a hand above it, as above each thing that a click acts on.
export component Push inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    callback clicked();
    height: 28px;
    min-width: caption.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: 5px;
    border-width: scope.has-focus ? 2px : 1px;
    border-color: scope.has-focus ? Palette.accent-background : root.primary ? Palette.accent-background : Tones.hairline;
    background: root.primary ? Palette.accent-background : Palette.control-background;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    forward-focus: scope;
    scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                // A held key repeats, and a repeat presses nothing: a second press needs a second stroke.
                if (!event.repeat) {
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
    }
    // The shade of a hover and of a press lies above either background.
    Rectangle {
        border-radius: root.border-radius;
        background: area.pressed ? Tones.pressed : area.has-hover ? Tones.hover : transparent;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    caption := Text {
        text: root.text;
        color: root.primary ? Palette.accent-foreground : Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// A box that a person marks, for a row of the plan.
export component Check inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: scope.has-focus ? 2px : 1px;
    border-color: scope.has-focus || root.checked ? Palette.accent-background : Tones.muted;
    background: root.checked ? Palette.accent-background : transparent;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-checkable: true;
    accessible-action-default => { root.toggled(); }
    forward-focus: scope;
    scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!event.repeat) {
                    root.toggled();
                }
                return accept;
            }
            return reject;
        }
    }
    TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.toggled(); } }
    if root.checked: Text { text: "✓"; color: Palette.accent-foreground; font-size: 11px; font-weight: 700; accessible-role: none; }
}

// The line of a group that opens and shuts: its mark, its name, its caption, and its size.
// A click toggles it, and so does Return or Space once the Tab key reaches it.
export component GroupHead inherits Rectangle {
    in property <string> name;
    in property <string> caption;
    in property <string> size;
    in property <bool> open;
    in property <brush> size-color: Palette.foreground;
    callback toggled();
    height: 16px;
    border-radius: 3px;
    border-width: scope.has-focus ? 2px : 0px;
    border-color: Palette.accent-background;
    forward-focus: scope;
    scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!event.repeat) {
                    root.toggled();
                }
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        spacing: 6px;
        Text {
            width: 8px;
            text: root.open ? "▾" : "▸";
            font-size: 10px;
            color: Tones.muted;
            vertical-alignment: center;
            accessible-role: none;
        }
        Text {
            text: root.name;
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }
        // A group states its count beside its name, so its row takes two lines.
        Text {
            text: root.caption;
            color: Tones.muted;
            font-size: 11px;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: root.size;
            font-size: 12px;
            color: root.size-color;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
}
